# Crypto Dev Dockerfile: Rust toolchain + Python + crypto tools
# Based on Dockerfile.dev, adds Python 3 + data science libraries

# syntax=docker/dockerfile:1

# ---- Builder ----
FROM rust:bookworm AS builder

WORKDIR /build
COPY . .

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/build/target \
    cargo build --release -p telegram-bot --bin telegram-bot \
    && cp /build/target/release/telegram-bot /build/telegram-bot-bin

# ---- Crypto Dev Runtime ----
FROM rust:bookworm

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssh-client \
    git \
    bash \
    curl \
    wget \
    dnsutils \
    build-essential \
    pkg-config \
    libssl-dev \
    vim-tiny \
    htop \
    file \
    unzip \
    ca-certificates \
    # Python dependencies
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

# Build TA-Lib C library from source
RUN cd /tmp \
    && wget -q https://github.com/ta-lib/ta-lib/releases/download/v0.6.4/ta-lib-0.6.4-src.tar.gz \
    && tar -xzf ta-lib-0.6.4-src.tar.gz \
    && cd ta-lib-0.6.4 \
    && ./configure --prefix=/usr \
    && make -j$(nproc) \
    && make install \
    && rm -rf /tmp/ta-lib*

# Install Python data science + crypto packages
RUN pip3 install --no-cache-dir --break-system-packages \
    pandas \
    numpy \
    ccxt \
    optuna \
    ta \
    matplotlib \
    requests \
    pyyaml \
    rich \
    scipy \
    scikit-learn \
    ta-lib

WORKDIR /app
COPY --from=builder /build/telegram-bot-bin /app/telegram-bot

ENTRYPOINT ["/app/telegram-bot"]
